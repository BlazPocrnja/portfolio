---
import PageLayout from '@/layouts/PageLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getI18n } from "@/i18n/index"
import { siteConfig } from '@/site.config';

const { currentLocale } = Astro
const i18n = await getI18n(currentLocale, 'design')
const homeUrl = getRelativeLocaleUrl(currentLocale, "/");
const mates = {
	title: '404',
	description: i18n('mate.description'),
	author: siteConfig.author,
	email: siteConfig.email,
	local: currentLocale,
	ogImage: getRelativeLocaleUrl(currentLocale, '/og-image/site-image.png'),
}
---

<PageLayout {...mates}>
	<div class="flex flex-col items-center justify-center min-h-screen">
		<h1 class="text-4xl font-bold mb-4">404</h1>
		<p class="text-lg mb-6">Page not found</p>
		<a href={homeUrl} class="px-6 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
			Go Home
		</a>
	</div>
</PageLayout>
