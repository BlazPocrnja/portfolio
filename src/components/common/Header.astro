---
import { getRelativeLocaleUrl } from 'astro:i18n';
import siteConfig from '@/site.config';
import { getI18n } from "@/i18n/index"
import { getMenus } from '@/config/menus';

const { currentLocale } = Astro
const i18n = await getI18n(currentLocale, 'design')

function getTargetUrl() {
  const lang = currentLocale === 'ja' ? 'en' : currentLocale;
  return siteConfig.site + getRelativeLocaleUrl(lang, '/')
}

const menus = getMenus(i18n('menus'), currentLocale);
---
<header class="max-w-none flex justify-between items-center p-4">
  <nav class="flex gap-4">
    {menus.map((menu) => (
      <a href={menu.href} class="hover:opacity-75 transition-opacity">
        {menu.label}
      </a>
    ))}
  </nav>
  <a href={getTargetUrl()} class="text-sm hover:opacity-75 transition-opacity">
    {currentLocale === 'en' ? 'English' : currentLocale === 'ja' ? '日本語' : currentLocale === 'zh-hant' ? '繁體中文' : '简体中文'}
  </a>
</header>

