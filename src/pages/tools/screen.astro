---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getI18n } from "@/i18n/index"
import { getRelativeLocaleUrl } from 'astro:i18n';
import { siteConfig } from '@/site.config';

const { currentLocale } = Astro
const i18n = await getI18n(currentLocale, 'blog')
const mates = {
  title: 'screen',
	description: i18n('mate.description'),
	author: siteConfig.author,
	email: siteConfig.email,
	local: currentLocale,
	ogImage: getRelativeLocaleUrl(currentLocale, '/og-image/site-image.png'),
}
---

<BaseLayout {...mates}>
  <div class="p-4">
    <h1 class="text-2xl mb-4">Screen Tool</h1>
    <p>This feature is being customized with GSAP animations.</p>
  </div>
</BaseLayout>

